# SYNTHETIC DEMO DATA. Copy to .env and fill in secrets. Never commit .env.

# AI
LLM_MODE=replay
OPENAI_MODEL=gpt-5.6-luna
OPENAI_API_KEY=
EFFORT_BUILD_MATRIX=medium
EFFORT_DRAFT_PACKET=low
LLM_CONCURRENCY=4

# Prices (USD per 1M tokens)
